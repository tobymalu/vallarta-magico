# Copia este archivo a .env y pon tu Container ID real de Google Tag
# Manager (Admin > Instalar Google Tag Manager, formato "GTM-XXXXXXX").
# Sin esta variable, GoogleTagManager.astro / GoogleTagManagerNoscript.astro
# no inyectan nada (evita mandar tráfico de desarrollo al contenedor de
# producción). GA4 y cualquier otro tag se configuran dentro de GTM, no
# aquí en el código.
PUBLIC_GTM_ID=
