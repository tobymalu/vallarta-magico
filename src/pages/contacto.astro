---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE, PUNTOS_ENCUENTRO, whatsappUrl } from "../lib/site";

const seo = {
  meta_title: "Contacto | Vallarta Mágico",
  meta_description:
    "Escríbenos por WhatsApp o correo, y encuentra los puntos de encuentro de nuestros tours en Puerto Vallarta y Bahía de Banderas.",
};

const ctaWhatsapp = whatsappUrl();
---

<Layout seo={seo} idioma="es">
  <Header idioma="es" />

  <section class="bg-primary px-6 py-20 text-center text-primary-foreground sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Contacto</p>
    <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">Hablemos de tu próxima aventura</h1>
    <p class="mx-auto mt-4 max-w-xl text-primary-foreground/80">
      ¿Dudas sobre un tour, disponibilidad o grupos grandes? Escríbenos, respondemos rápido.
    </p>

    <a
      href={ctaWhatsapp}
      target="_blank"
      rel="noopener noreferrer"
      data-ga-event="click_whatsapp_contacto"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-8 py-3.5 text-base font-semibold text-accent-foreground transition hover:bg-accent/90"
    >
      Escribir por WhatsApp
    </a>

    <div class="mx-auto mt-8 flex max-w-md flex-col items-center gap-4 border-t border-primary-foreground/15 pt-6 sm:flex-row sm:justify-between">
      <a href={`mailto:${SITE.email}`} class="text-sm text-primary-foreground/90 hover:text-accent">
        {SITE.email}
      </a>
      <SocialLinks />
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-serif text-3xl text-foreground">Puntos de encuentro</h2>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        Cada tour zarpa o sale de un punto distinto — revisa el itinerario de tu tour para confirmar el que te toca.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          PUNTOS_ENCUENTRO.map((punto) => (
            <div class="overflow-hidden rounded-2xl border border-foreground/10 bg-white">
              {punto.mapaQuery && (
                <iframe
                  title={`Mapa: ${punto.nombre}`}
                  src={`https://maps.google.com/maps?q=${encodeURIComponent(punto.mapaQuery)}&output=embed`}
                  class="h-40 w-full border-0"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              )}
              <div class="p-5">
                <h3 class="font-serif text-lg text-foreground">{punto.nombre}</h3>
                <p class="mt-1 text-sm text-muted">{punto.direccion}</p>
                <p class="mt-3 text-sm text-foreground/80">{punto.nota}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Layout>
