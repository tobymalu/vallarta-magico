---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FeaturedGrid from "../components/FeaturedGrid.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import { TESTIMONIOS } from "../lib/testimonios";
import heroImage from "../assets/home-hero.jpg";

// OG image real del Home a partir de la foto del hero (mismo patrón que
// tours/[slug].astro) — mejor que caer al fallback /og-default.jpg
// genérico (que además todavía no existe) para la página más compartida
// del sitio.
const ogImage = await getImage({ src: heroImage, width: 1200, height: 630 });

// SEO del Home — esto luego se puede mover a un archivo de configuración
// central si prefieres no tenerlo hardcodeado aquí.
const seo = {
  meta_title: "Vallarta Mágico | Tours y Excursiones en Puerto Vallarta",
  meta_description:
    "Descubre las mejores excursiones en Puerto Vallarta y Bahía de Banderas: islas Marietas, Yelapa, avistamiento de ballenas y más.",
  og_image: ogImage.src,
};
---

<Layout seo={seo} idioma="es">
  <Header idioma="es" />

  <section class="relative isolate overflow-hidden">
    <Image
      src={heroImage}
      alt="Las letras de Puerto Vallarta y el Caballito de Mar en el malecón"
      width={1920}
      height={800}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      priority
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-primary via-primary/80 to-primary/40" />

    <div class="px-6 py-24 text-center text-primary-foreground sm:py-32">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">
        Bienvenido a
      </p>
      <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">
        Vallarta Mágico
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-primary-foreground/80">
        Descubre las mejores excursiones en Puerto Vallarta y Bahía de
        Banderas: islas Marietas, Yelapa, avistamiento de ballenas y más.
      </p>
    </div>
  </section>

  <FeaturedGrid idioma="es" />

  <TestimonialGrid
    titulo="Lo que dicen nuestros viajeros"
    subtitulo="Reseñas reales de Google, de gente que ya vivió la experiencia."
    reviews={TESTIMONIOS}
  />

  <Footer />
</Layout>
