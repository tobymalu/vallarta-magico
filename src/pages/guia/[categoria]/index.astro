---
// Página de "Archivo": un artículo por categoría, para que el usuario
// navegue por lo que le interesa (pedido explícito del brief). Genera
// las 4 categorías siempre, aunque todavía no tengan artículos —son
// destinos de navegación fijos, no algo que aparezca/desaparezca según
// haya contenido cargado.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { CATEGORIAS_GUIA } from "../../../content.config";
import { CATEGORIA_INFO } from "../../../lib/guia";

export async function getStaticPaths() {
  return CATEGORIAS_GUIA.map((categoria) => ({ params: { categoria } }));
}

const { categoria } = Astro.params as { categoria: (typeof CATEGORIAS_GUIA)[number] };
const info = CATEGORIA_INFO[categoria];

const articulos = (await getCollection("guia")).filter((a) => a.data.categoria === categoria);

const seo = {
  meta_title: `${info.label} en Puerto Vallarta | Guía de Vallarta Mágico`,
  meta_description: info.descripcion,
};
---

<Layout seo={seo} idioma="es">
  <Header idioma="es" />

  <nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-6 pt-4 text-xs text-muted">
    <ol class="flex flex-wrap items-center gap-1">
      <li><a href="/guia" class="hover:text-primary">Guía</a></li>
      <li class="flex items-center gap-1">
        <span aria-hidden="true">/</span>
        <span class="text-foreground">{info.label}</span>
      </li>
    </ol>
  </nav>

  <section class="px-6 pb-8 pt-6 text-center sm:pt-10">
    <h1 class="font-serif text-3xl text-foreground sm:text-4xl">{info.label}</h1>
    <p class="mx-auto mt-3 max-w-xl text-sm text-muted">{info.descripcion}</p>
  </section>

  <section class="px-6 pb-16">
    <div class="mx-auto max-w-5xl">
      {
        articulos.length === 0 ? (
          <p class="text-center text-muted">Todavía no hay artículos en esta categoría — vuelve pronto.</p>
        ) : (
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
            {articulos.map((a) => (
              <a
                href={`/guia/${categoria}/${a.id}`}
                class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-foreground/5 transition hover:shadow-md"
              >
                {a.data.imagen_portada && (
                  <div class="aspect-16/9 overflow-hidden">
                    <Image
                      src={a.data.imagen_portada}
                      alt={a.data.titulo}
                      width={640}
                      height={360}
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <h2 class="font-serif text-xl text-foreground">{a.data.titulo}</h2>
                  <p class="line-clamp-2 text-sm text-muted">{a.data.descripcion}</p>
                  <span class="mt-auto pt-4 text-sm font-semibold text-accent group-hover:underline">
                    Leer guía →
                  </span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Footer />
</Layout>
