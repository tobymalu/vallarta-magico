---
// Portada de la guía: un archivo por categoría (ver CATEGORIAS_GUIA en
// content.config.ts) — la navegación por categoría vive en
// /guia/[categoria], esta página solo presenta las 4 puertas de entrada.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { CATEGORIAS_GUIA } from "../../content.config";
import { CATEGORIA_INFO } from "../../lib/guia";

const seo = {
  meta_title: "Guía de Puerto Vallarta: Qué Hacer, Comer y Saber | Vallarta Mágico",
  meta_description:
    "La guía de Vallarta Mágico: qué hacer, dónde comer, información útil y tips de hospedaje en Puerto Vallarta y Bahía de Banderas.",
};

const todaLaGuia = await getCollection("guia");

const categorias = CATEGORIAS_GUIA.map((slug) => ({
  slug,
  ...CATEGORIA_INFO[slug],
  cantidad: todaLaGuia.filter((a) => a.data.categoria === slug).length,
}));
---

<Layout seo={seo} idioma="es">
  <Header idioma="es" />

  <section class="bg-primary px-6 py-16 text-center text-primary-foreground sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Guía del destino</p>
    <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">Todo sobre Puerto Vallarta</h1>
    <p class="mx-auto mt-4 max-w-xl text-primary-foreground/80">
      Qué hacer, dónde comer y todo lo práctico para tu viaje a la bahía.
    </p>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
      {
        categorias.map((cat) => (
          <a
            href={`/guia/${cat.slug}`}
            class="group rounded-2xl border border-foreground/10 bg-white p-6 transition hover:shadow-md"
          >
            <h2 class="font-serif text-xl text-foreground">{cat.label}</h2>
            <p class="mt-2 text-sm text-muted">{cat.descripcion}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-accent group-hover:underline">
              {cat.cantidad > 0 ? `Ver artículos →` : "Próximamente →"}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <Footer />
</Layout>
