---
// Versión en inglés de /contacto. PUNTOS_ENCUENTRO se traduce aquí mismo
// (no en site.ts) porque es la única página que lo usa — mismo criterio
// que el resto del contenido "de una sola página" en este proyecto.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { SITE, PUNTOS_ENCUENTRO, whatsappUrl } from "../../lib/site";

const seo = {
  meta_title: "Contact | Vallarta Mágico",
  meta_description:
    "Message us on WhatsApp or email, and find the meeting points for our tours in Puerto Vallarta and Banderas Bay.",
};

const ctaWhatsapp = whatsappUrl("Hi! I'd like information about tours in Puerto Vallarta and Banderas Bay.");

// Mismos puntos/direcciones que PUNTOS_ENCUENTRO (site.ts), solo
// traducidos nombre/nota — el orden y el mapaQuery se mantienen 1:1 por
// índice.
const notasEn = [
  "Departure for our boat tours: Marietas Islands, Yelapa and Majahuitas, and Whale Watching.",
  "Alternate departure for the Los Veranos Canopy with Speedboat tour.",
  "Alternate departure for the Los Veranos Canopy with Speedboat tour.",
  "Departure for the ATV & RZR Cuale River Route tour.",
  "Departure for the Colomitos & Las Ánimas tour.",
];
const nombresEn = [
  "Puerto Mágico (Beachboy Office)",
  'Pier "E", Paradise Village',
  "Los Veranos Office",
  "ATV & RZR Base, Cuale Route",
  "Terminal Marítima",
];
---

<Layout seo={seo} idioma="en" urlAlterna="/contacto/">
  <Header idioma="en" urlAlterna="/contacto/" />

  <section class="bg-primary px-6 py-20 text-center text-primary-foreground sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Contact</p>
    <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">Let's talk about your next adventure</h1>
    <p class="mx-auto mt-4 max-w-xl text-primary-foreground/80">
      Questions about a tour, availability, or large groups? Message us, we reply fast.
    </p>

    <a
      href={ctaWhatsapp}
      target="_blank"
      rel="noopener noreferrer"
      data-ga-event="click_whatsapp_contacto"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-8 py-3.5 text-base font-semibold text-accent-foreground transition hover:bg-accent/90"
    >
      Message us on WhatsApp
    </a>

    <div class="mx-auto mt-8 flex max-w-md flex-col items-center gap-4 border-t border-primary-foreground/15 pt-6 sm:flex-row sm:justify-between">
      <a href={`mailto:${SITE.email}`} class="text-sm text-primary-foreground/90 hover:text-accent">
        {SITE.email}
      </a>
      <SocialLinks />
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-serif text-3xl text-foreground">Meeting points</h2>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        Each tour departs from a different spot — check your tour's itinerary to confirm yours.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          PUNTOS_ENCUENTRO.map((punto, i) => (
            <div class="overflow-hidden rounded-2xl border border-foreground/10 bg-white">
              {punto.mapaQuery && (
                <iframe
                  title={`Map: ${nombresEn[i]}`}
                  src={`https://maps.google.com/maps?q=${encodeURIComponent(punto.mapaQuery)}&output=embed`}
                  class="h-40 w-full border-0"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              )}
              <div class="p-5">
                <h3 class="font-serif text-lg text-foreground">{nombresEn[i]}</h3>
                <p class="mt-1 text-sm text-muted">{punto.direccion}</p>
                <p class="mt-3 text-sm text-foreground/80">{notasEn[i]}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer idioma="en" />
</Layout>
