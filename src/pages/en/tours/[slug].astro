---
// Versión en inglés de /tours/[slug] — misma lógica de negocio que la
// página en español (temporada, promo, precios), solo con copy en
// inglés y leyendo las entradas "-en" de la colección "tours" (ver
// content/tours/*-en/). El slug de la URL NUNCA lleva el sufijo "-en"
// (eso es un detalle interno del content collection, no de la URL).
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import TourHero from "../../../components/TourHero.astro";
import PriceTable from "../../../components/PriceTable.astro";
import IncludeExclude from "../../../components/IncludeExclude.astro";
import Timeline from "../../../components/Timeline.astro";
import FaqList from "../../../components/FaqList.astro";
import StickyBookBar from "../../../components/StickyBookBar.astro";
import TourCard from "../../../components/TourCard.astro";
import TestimonialGrid from "../../../components/TestimonialGrid.astro";
import Gallery from "../../../components/Gallery.astro";
import { whatsappUrl, SITE } from "../../../lib/site";
import { estaEnTemporada } from "../../../lib/temporada";

export async function getStaticPaths() {
  const tours = (await getCollection("tours")).filter((t) => t.id.endsWith("-en"));
  return tours.map((tour) => ({
    params: { slug: tour.id.replace(/-en$/, "") },
    props: { tour, todos: tours },
  }));
}

const { tour, todos } = Astro.props;
const t = tour.data;
const slug = tour.id.replace(/-en$/, "");

// imagen_portada quedó "optional" en el schema por flexibilidad a
// futuro (ver content.config.ts) — en la práctica, todo tour (ES o "-en")
// siempre trae la suya, así que el "!" es seguro aquí.
const imagenPortada = t.imagen_portada!;
const ogImage = await getImage({ src: imagenPortada, width: 1200, height: 630 });

const seo = {
  meta_title: t.seo.meta_title,
  meta_description: t.seo.meta_description,
  canonical: t.seo.canonical,
  og_image: t.seo.og_image ?? ogImage.src,
  noindex: t.seo.noindex,
};

const preciosPrincipales = t.precios.filter((p) => p.tipo !== "addon");
const precioMasBajo = (
  preciosPrincipales.length > 0 ? preciosPrincipales : t.precios
).reduce((min, p) => (p.precio < min.precio ? p : min));
const enTemporada = estaEnTemporada(t.temporada);
const ctaLabelReserva = enTemporada ? "Check Availability & Book" : "Join the Waitlist";
const ctaLabelPrecio = enTemporada ? "I want my spot" : "Join the waitlist";
const ctaLabelSticky = enTemporada ? "Book Now" : "Waitlist";
const nivelPromo = preciosPrincipales.find((p) => /^adults/i.test(p.etiqueta)) ?? precioMasBajo;
const enPromo = Boolean(nivelPromo.precio_regular);
const mensajeSticky = !enTemporada
  ? `From $${precioMasBajo.precio.toLocaleString("en-US")} ${precioMasBajo.moneda}`
  : enPromo
    ? "Book now for a limited time."
    : "Get 20% off booking today!";
const avisoTemporada =
  !enTemporada && t.temporada ? `Out of season. This tour operates ${t.temporada.descripcion}.` : undefined;
const ctaWhatsapp = whatsappUrl(
  enTemporada
    ? `Hi, I'd like to book the "${t.nombre}" tour.`
    : `Hi, I'd like to join the waitlist for the "${t.nombre}" tour for next season (${t.temporada?.descripcion}).`,
);

const garantiaHref = enTemporada ? "/en/cancellation-policy" : undefined;

// Tours relacionados: el resto de las entradas en inglés.
const relacionados = todos.filter((otro) => otro.id !== tour.id).slice(0, 3);

const breadcrumbs = [
  { name: "Home", url: `${SITE.url}/en/` },
  { name: "Tours", url: `${SITE.url}/en/tours` },
  { name: t.nombre, url: `${SITE.url}/en/tours/${slug}` },
];

const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};

const jsonLdProduct = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: t.nombre,
  description: t.descripcion_corta,
  image: new URL(ogImage.src, SITE.url).toString(),
  brand: { "@type": "Brand", name: "Vallarta Mágico" },
  offers: t.precios.map((p) => ({
    "@type": "Offer",
    name: p.etiqueta,
    price: p.precio,
    priceCurrency: p.moneda,
    availability: "https://schema.org/InStock",
    url: `${SITE.url}/en/tours/${slug}`,
  })),
};

const jsonLdAttraction = t.atraccion
  ? {
      "@context": "https://schema.org",
      "@type": "TouristAttraction",
      name: t.atraccion.nombre,
      description: t.atraccion.descripcion,
      address: {
        "@type": "PostalAddress",
        ...(t.atraccion.region ? { addressRegion: t.atraccion.region } : {}),
        addressCountry: "MX",
      },
    }
  : null;

const jsonLdFaq =
  t.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: t.faq.map((f) => ({
          "@type": "Question",
          name: f.pregunta,
          acceptedAnswer: { "@type": "Answer", text: f.respuesta },
        })),
      }
    : null;
---

<Layout seo={seo} idioma="en" mostrarWhatsappFlotante={false} urlAlterna={`/tours/${slug}/`}>
  <Header idioma="en" urlAlterna={`/tours/${slug}/`} />

  <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-6 pt-4 text-xs text-muted">
    <ol class="flex flex-wrap items-center gap-1">
      {
        breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-1">
            {i > 0 && <span aria-hidden="true">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="text-foreground">{b.name}</span>
            ) : (
              <a href={b.url.replace(SITE.url, "")} class="hover:text-primary">
                {b.name}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <TourHero
    h1={t.h1}
    subtitulo={t.subtitulo}
    badges={t.badges}
    imagen={imagenPortada}
    ctaHref={ctaWhatsapp}
    ctaLabel={ctaLabelReserva}
    avisoTemporada={avisoTemporada}
    garantiaHref={garantiaHref}
    idioma="en"
  />

  <section class="px-6 py-12">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-serif text-2xl text-foreground">What's waiting for you on this tour?</h2>
      <p class="mt-3 text-foreground/90">{t.tldr}</p>
    </div>
  </section>

  <PriceTable
    precios={t.precios}
    notaPrecio={t.nota_precio}
    highlights={t.highlights}
    ctaHref={ctaWhatsapp}
    ctaLabel={ctaLabelPrecio}
    garantiaHref={garantiaHref}
    idioma="en"
  />

  {t.featuredReview && <TestimonialGrid reviews={[t.featuredReview]} />}

  <IncludeExclude incluye={t.incluye} noIncluye={t.no_incluye} idioma="en" />

  <Timeline items={t.itinerario} idioma="en" />

  {
    (t.que_traer.length > 0 || t.restricciones.length > 0) && (
      <section class="px-6 py-14">
        <div class="mx-auto grid max-w-4xl grid-cols-1 gap-10 sm:grid-cols-2">
          {t.que_traer.length > 0 && (
            <div>
              <h2 class="font-serif text-2xl text-foreground">What to bring</h2>
              <ul class="mt-5 space-y-2 text-sm text-foreground">
                {t.que_traer.map((item) => <li>• {item}</li>)}
              </ul>
            </div>
          )}
          {t.restricciones.length > 0 && (
            <div>
              <h2 class="font-serif text-2xl text-foreground">
                For your safety, the tour isn't suitable for
              </h2>
              <ul class="mt-5 space-y-2 text-sm text-muted">
                {t.restricciones.map((item) => <li>• {item}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  <Gallery fotos={t.galeria} titulo="Gallery" />

  {t.faq.length > 0 && <FaqList items={t.faq} idioma="en" />}

  {
    relacionados.length > 0 && (
      <section class="px-6 py-14">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-serif text-2xl text-foreground">
            Other tours you might like
          </h2>
          <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relacionados.map((otro) => (
              <TourCard tour={otro} basePath="/en/tours" idioma="en" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Footer idioma="en" />

  <StickyBookBar
    mensaje={mensajeSticky}
    ctaHref={ctaWhatsapp}
    ctaLabel={ctaLabelSticky}
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdProduct)} />
  {jsonLdAttraction && <script type="application/ld+json" set:html={JSON.stringify(jsonLdAttraction)} />}
  {jsonLdFaq && <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />}
</Layout>
