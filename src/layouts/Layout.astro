---
import "../styles/global.css";
import GoogleTagManager from "../components/GoogleTagManager.astro";
import GoogleTagManagerNoscript from "../components/GoogleTagManagerNoscript.astro";
import CookieBanner from "../components/CookieBanner.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

export interface Props {
  seo: {
    meta_title: string;
    meta_description: string;
    canonical?: string;
    og_image?: string;
    noindex?: boolean;
  };
  idioma?: "es" | "en";
  // false en páginas de tour: ahí StickyBookBar (mobile) y los CTAs del
  // Hero/PriceTable (desktop) ya cubren la conversión — el botón flotante
  // ahí era un WhatsApp redundante encima de esos CTAs.
  mostrarWhatsappFlotante?: boolean;
  // URL de la contraparte real en el otro idioma (ej. la página pasa
  // "/en/" desde "/", o "/" desde "/en/"). Solo se declara cuando esa
  // contraparte EXISTE de verdad — todavía es solo el Home (fase 1 del
  // sitio bilingüe). Publicar un hreflang que apunte a una URL que no
  // existe es peor que no tener hreflang — Google lo trata como señal
  // rota, por eso el resto de las páginas se quedan sin este prop.
  urlAlterna?: string;
}

const { seo, idioma = "es", mostrarWhatsappFlotante = true, urlAlterna } = Astro.props;

const siteUrl = "https://vallartamagico.com";
const canonical = seo.canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = seo.og_image
  ? new URL(seo.og_image, siteUrl).toString()
  : new URL("/og-default.jpg", siteUrl).toString();

const locales = { es: "es_MX", en: "en_US" };
const idiomaAlterno = idioma === "en" ? "es" : "en";
const urlAlternaAbsoluta = urlAlterna ? new URL(urlAlterna, siteUrl).toString() : undefined;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager: lo más alto posible dentro de <head>, solo
         después de charset/viewport (esos dos van primero por spec de
         HTML, charset debe declararse en los primeros 1024 bytes). -->
    <GoogleTagManager />

    <meta name="theme-color" content="#0b4f4a" />

    <!-- Favicons (generados con RealFaviconGenerator, logo real de la marca) -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{seo.meta_title}</title>
    <meta name="description" content={seo.meta_description} />
    <link rel="canonical" href={canonical} />
    <!-- Explícito siempre (no solo cuando noindex): index/follow por
         ausencia de etiqueta ya es el default de los buscadores, pero
         varias herramientas de auditoría SEO marcan como hallazgo que
         la etiqueta robots no esté presente en el HTML. -->
    <meta name="robots" content={seo.noindex ? "noindex, nofollow" : "index, follow"} />

    <link rel="alternate" hreflang={idioma} href={canonical} />
    {urlAlternaAbsoluta && <link rel="alternate" hreflang={idiomaAlterno} href={urlAlternaAbsoluta} />}
    <link rel="alternate" hreflang="x-default" href={idioma === "es" ? canonical : (urlAlternaAbsoluta ?? canonical)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.meta_title} />
    <meta property="og:description" content={seo.meta_description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[idioma]} />
    <meta property="og:site_name" content="Vallarta Mágico" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.meta_title} />
    <meta name="twitter:description" content={seo.meta_description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fuentes: Fraunces (títulos, serif editorial) + Inter (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground">
    <!-- Salta el Header/nav (accesibilidad, WCAG 2.4.1) — el destino
         #contenido vive en Header.astro, justo después del <header>. -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:shadow-lg"
    >
      {idioma === "en" ? "Skip to content" : "Saltar al contenido"}
    </a>
    <GoogleTagManagerNoscript />
    <slot />
    <CookieBanner idioma={idioma} />
    {mostrarWhatsappFlotante && <FloatingWhatsApp idioma={idioma} />}
  </body>
</html>
