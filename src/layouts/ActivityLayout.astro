---
// Layout "editorial" para la colección de actividades — deliberadamente
// distinto del layout de tours: columna de lectura angosta, tipografía
// grande (prose-lg), sin componentes de venta duros (precios, itinerario).
// La conversión aquí es sutil, vía CalloutTour.astro dentro del cuerpo.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  seo: {
    meta_title: string;
    meta_description: string;
    canonical?: string;
    og_image?: string;
    noindex?: boolean;
  };
  h1: string;
  // Etiqueta de la categoría (ej. "Qué Hacer"), mostrada como eyebrow
  // sobre el H1 — antes decía fijo "Guía de actividades", ahora la guía
  // tiene 4 categorías distintas (ver CATEGORIA_INFO en src/lib/guia.ts).
  categoriaLabel: string;
  imagenPortada?: ImageMetadata;
  datosRapidos?: { etiqueta: string; valor: string }[];
  breadcrumbs?: { name: string; url: string }[];
  // Fecha de última revisión editorial (campo fecha_actualizacion del
  // schema de "guia") — se muestra sobre el cuerpo del artículo.
  fechaActualizacion?: Date;
  idioma?: "es" | "en";
  // URL de la contraparte real en el otro idioma, para el hreflang — ver
  // mismo prop en Layout.astro.
  urlAlterna?: string;
}

const {
  seo,
  h1,
  categoriaLabel,
  imagenPortada,
  datosRapidos = [],
  breadcrumbs = [],
  fechaActualizacion,
  idioma = "es",
  urlAlterna,
} = Astro.props;

// timeZone: "UTC" a propósito — z.coerce.date() en content.config.ts
// parsea "2026-09-16" como medianoche UTC. Sin fijar la zona aquí, un
// build/servidor en una zona horaria detrás de UTC (ej. México) mostraría
// un día antes del que se escribió en el frontmatter.
const fechaFormateada = fechaActualizacion
  ? new Intl.DateTimeFormat(idioma === "en" ? "en-US" : "es-MX", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(fechaActualizacion)
  : undefined;
---

<Layout seo={seo} idioma={idioma} urlAlterna={urlAlterna}>
  <Header idioma={idioma} urlAlterna={urlAlterna} />

  {
    breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mx-auto max-w-3xl px-6 pt-4 text-xs text-muted">
        <ol class="flex flex-wrap items-center gap-1">
          {breadcrumbs.map((b, i) => (
            <li class="flex items-center gap-1">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i === breadcrumbs.length - 1 ? (
                <span class="text-foreground">{b.name}</span>
              ) : (
                <a href={b.url} class="hover:text-primary">
                  {b.name}
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <!-- Hero: si hay foto de portada, se muestra completa (sin recortar) a
       su proporción real — solo width, sin height, para que Astro calcule
       el alto a partir del original en vez de forzar un crop a 16:9.
       El texto va anclado abajo. Degradado chico (h-40/h-56) a propósito:
       tapa lo menos posible de la foto — la legibilidad la carga sobre
       todo el drop-shadow del texto (más fuerte que un primer intento),
       no una franja de color grande encima de la imagen. -->
  <section class="relative isolate mt-4 overflow-hidden bg-primary">
    {
      imagenPortada ? (
        <>
          <Image src={imagenPortada} alt="" role="presentation" width={1600} class="w-full h-auto" />
          <div class="absolute inset-x-0 bottom-0 h-40 bg-linear-to-t from-primary to-transparent sm:h-56" />
          <div class="absolute inset-x-0 bottom-0 px-6 pb-6 text-center text-primary-foreground sm:pb-10">
            <div class="mx-auto max-w-3xl">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent drop-shadow-[0_2px_8px_rgba(0,0,0,0.75)]">
                {categoriaLabel}
              </p>
              <h1 class="mt-2 font-serif text-3xl leading-tight drop-shadow-[0_2px_14px_rgba(0,0,0,0.75)] sm:text-5xl">
                {h1}
              </h1>
            </div>
          </div>
        </>
      ) : (
        <div class="bg-linear-to-t from-primary via-primary/80 to-primary/40 px-6 py-24 text-center text-primary-foreground sm:py-32">
          <div class="mx-auto max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{categoriaLabel}</p>
            <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">{h1}</h1>
          </div>
        </div>
      )
    }
  </section>

  <!-- Ficha de datos rápidos (TL;DR) -->
  {
    datosRapidos.length > 0 && (
      <div class="border-b border-foreground/10 bg-white px-6 py-8">
        <dl class="mx-auto grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
          {datosRapidos.map((dato) => (
            <div class="text-center">
              <dt class="text-xs font-semibold uppercase tracking-wide text-muted">{dato.etiqueta}</dt>
              <dd class="mt-1 text-sm font-medium text-foreground">{dato.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  <!-- Cuerpo del artículo: columna angosta, tipografía editorial -->
  <article
    class="prose prose-lg mx-auto max-w-3xl px-6 py-14
      prose-headings:font-serif prose-headings:text-foreground
      prose-h2:mt-12 prose-p:text-foreground/90 prose-li:text-foreground/90
      prose-strong:text-foreground prose-a:text-accent prose-a:no-underline hover:prose-a:underline"
  >
    {
      fechaFormateada && (
        <p class="mt-0! mb-8! text-sm text-muted not-prose">
          {idioma === "en" ? "Updated on " : "Actualizado el "}
          <time datetime={fechaActualizacion?.toISOString()}>{fechaFormateada}</time>
        </p>
      )
    }
    <slot />
  </article>

  <slot name="despues-del-articulo" />

  <Footer idioma={idioma} />
</Layout>
