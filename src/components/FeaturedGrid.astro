---
import { getCollection, type CollectionEntry } from "astro:content";
import TourCard from "./TourCard.astro";

export interface Props {
  idioma?: "es" | "en";
}

const { idioma = "es" } = Astro.props;
const esEn = idioma === "en";
const basePath = esEn ? "/en/tours" : "/tours";

const t = esEn
  ? {
      eyebrow: "Experiences",
      titulo: "Most popular tours",
      vacio: "No tours loaded in this collection yet.",
    }
  : {
      eyebrow: "Experiencias",
      titulo: "Tours más buscados",
      vacio: "Todavía no hay tours cargados en esta colección.",
    };

// Entradas en inglés = slug con sufijo "-en" (ver content/tours/*-en/).
// Mismo filtro de "destacados" que en español, porque cada entrada "-en"
// replica destacado/orden_destacado de su contraparte.
const todosLosTours = (await getCollection("tours")).filter((tour) =>
  esEn ? tour.id.endsWith("-en") : !tour.id.endsWith("-en"),
);

const destacados = todosLosTours
  .filter((tour) => tour.data.destacado)
  .sort((a, b) => (a.data.orden_destacado ?? 999) - (b.data.orden_destacado ?? 999));

// Si no hay 6 destacados todavía, rellenamos con el resto de tours para
// que el grid nunca se vea incompleto mientras cargamos contenido real.
const relleno = todosLosTours.filter((tour) => !tour.data.destacado);

const tours: CollectionEntry<"tours">[] = [...destacados, ...relleno].slice(0, 6);
---

<section class="px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">
      {t.eyebrow}
    </p>
    <h2 class="mt-2 font-serif text-3xl text-foreground sm:text-4xl">
      {t.titulo}
    </h2>

    {
      tours.length === 0 ? (
        <p class="mt-8 text-muted">
          {t.vacio}
        </p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {tours.map((tour) => (
            <TourCard tour={tour} basePath={basePath} idioma={idioma} />
          ))}
        </div>
      )
    }
  </div>
</section>
