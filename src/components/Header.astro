---
import { Image } from "astro:assets";
import { NAV_LINKS, NAV_LINKS_EN, whatsappUrl } from "../lib/site";
import logo from "../assets/logo.png";

export interface Props {
  idioma?: "es" | "en";
  // URL de la contraparte real de ESTA página en el otro idioma (mismo
  // valor que ya se le pasa a Layout/ActivityLayout como "urlAlterna") —
  // si se pasa, el selector de idioma manda ahí en vez de al Home. Se
  // omite en páginas que todavía no tienen traducción.
  urlAlterna?: string;
}

const { idioma = "es", urlAlterna } = Astro.props;
const esEn = idioma === "en";
const inicio = esEn ? "/en/" : "/";
const links = esEn ? NAV_LINKS_EN : NAV_LINKS;

// Selector de idioma: si la página actual declara su contraparte real
// (urlAlterna), el switcher manda ahí — así te quedas en el mismo tour o
// artículo, solo que en el otro idioma. Si no la declara (contenido que
// aún no se tradujo), cae de vuelta al Home del otro idioma.
const switchHref = urlAlterna ?? (esEn ? "/" : "/en/");
const switchLabel = esEn ? "ES" : "EN";
const switchAriaLabel = esEn ? "Cambiar a español" : "Switch to English";

const ctaLabel = esEn ? "Book via WhatsApp" : "Reservar por WhatsApp";
const ctaMensaje = esEn
  ? "Hi! I'd like information about tours in Puerto Vallarta and Banderas Bay."
  : undefined; // undefined = usa SITE.whatsapp.mensajeDefault (ya en español)
const ctaWhatsapp = whatsappUrl(ctaMensaje);

const t = esEn
  ? {
      navPrincipal: "Main navigation",
      navMovil: "Mobile navigation",
      abrirMenu: "Open menu",
    }
  : {
      navPrincipal: "Navegación principal",
      navMovil: "Navegación móvil",
      abrirMenu: "Abrir menú",
    };
---

<header class="sticky top-0 z-50 border-b border-foreground/10 bg-background/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={inicio} class="flex items-center gap-2.5 font-serif text-xl text-primary">
      <Image src={logo} alt="" role="presentation" width={40} height={40} class="h-10 w-10 rounded-full" />
      Vallarta <span class="text-accent">Mágico</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label={t.navPrincipal}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-foreground transition hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={switchHref}
        aria-label={switchAriaLabel}
        class="text-sm font-semibold text-muted transition hover:text-primary"
      >
        {switchLabel}
      </a>
      <a
        href={ctaWhatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground transition hover:bg-accent/90"
      >
        {ctaLabel}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center rounded-md p-2 text-foreground lg:hidden"
      aria-label={t.abrirMenu}
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav
    id="menu-movil"
    class="hidden flex-col gap-1 border-t border-foreground/10 bg-background px-6 py-4 lg:hidden"
    aria-label={t.navMovil}
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-2 py-2.5 text-sm font-medium text-foreground hover:bg-primary/5"
        >
          {link.label}
        </a>
      ))
    }
    <a href={switchHref} aria-label={switchAriaLabel} class="rounded-md px-2 py-2.5 text-sm font-medium text-muted hover:bg-primary/5">
      {switchLabel === "EN" ? "English" : "Español"}
    </a>
    <a
      href={ctaWhatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground"
    >
      {ctaLabel}
    </a>
  </nav>
</header>

<!-- Destino del link "Saltar al contenido" de Layout.astro — Header se
     usa siempre como lo primero después de <body>, así que este ancla
     (sibling, no dentro de <header>) cubre a toda página del sitio sin
     tener que agregar un <main id="contenido"> en cada una. tabindex="-1"
     para que el foco realmente se mueva ahí en todos los navegadores. -->
<div id="contenido" tabindex="-1"></div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu-movil");

  toggle?.addEventListener("click", () => {
    const abierto = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(abierto));
    menu?.classList.toggle("flex", abierto);
  });
</script>
