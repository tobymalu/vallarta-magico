---
// Tarjeta visual para cada entrada del listicle de hoteles frente al mar
// (/guia/hospedaje-tips/mejores-hoteles-frente-al-mar-puerto-vallarta).
// Solo la foto + los datos estructurados (estilo, ubicación) — el texto
// de "por qué destaca" / "ideal para" se queda como prosa normal del
// .mdx justo debajo, para que un editor sin acceso al código pueda
// corregirlo sin tocar props (mismo criterio que CalloutTour.astro: el
// componente es el elemento visual, no dueño de todo el copy).
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  numero: number;
  nombre: string;
  imagen: ImageMetadata;
  alt: string;
  estilo: string;
  ubicacion: string;
}

const { numero, nombre, imagen, alt, estilo, ubicacion } = Astro.props;
---

<div class="not-prose mt-14 first:mt-8">
  <div class="relative overflow-hidden rounded-2xl">
    <Image
      src={imagen}
      alt={alt}
      width={960}
      height={540}
      class="h-56 w-full object-cover sm:h-72"
    />
    <span
      class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-accent font-serif text-lg font-semibold text-accent-foreground shadow-md"
      aria-hidden="true"
    >
      {numero}
    </span>
  </div>

  <h3 class="mt-4 font-serif text-2xl text-foreground">{nombre}</h3>

  <div class="mt-2 flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">{estilo}</span>
    <span class="rounded-full bg-foreground/5 px-3 py-1 text-xs font-medium text-muted">📍 {ubicacion}</span>
  </div>
</div>
