---
export interface Props {
  items: { hora?: string; titulo: string; descripcion: string }[];
}

const { items } = Astro.props;
---

<section class="px-6 py-14">
  <div class="mx-auto max-w-2xl">
    <h2 class="font-serif text-2xl text-foreground">Itinerario del día</h2>

    <ol class="mt-8 space-y-8 border-l-2 border-primary/20 pl-6">
      {
        items.map((item) => (
          <li class="relative">
            <span class="absolute -left-[1.95rem] top-1 h-3 w-3 rounded-full bg-primary" />
            {item.hora && (
              <p class="text-sm font-semibold uppercase tracking-wide text-accent">
                {item.hora}
              </p>
            )}
            <h3 class="mt-1 font-serif text-lg text-foreground">{item.titulo}</h3>
            <p class="mt-1 text-sm text-muted">{item.descripcion}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
