---
// Iconos de redes sociales, extraídos de Footer.astro para reusarlos
// también en /contacto sin duplicar los 3 SVG inline.
import { SITE } from "../lib/site";

export interface Props {
  linkClass?: string;
  iconClass?: string;
}

const {
  linkClass = "text-primary-foreground/80 transition hover:text-accent",
  iconClass = "h-5 w-5",
} = Astro.props;

const redes = [
  { nombre: "Facebook", href: SITE.redes.facebook },
  { nombre: "Instagram", href: SITE.redes.instagram },
  { nombre: "TikTok", href: SITE.redes.tiktok },
];
---

<div class="flex items-center gap-4">
  {
    redes.map((red) => (
      <a href={red.href} target="_blank" rel="noopener noreferrer" aria-label={red.nombre} class={linkClass}>
        {red.nombre === "Facebook" && (
          <svg xmlns="http://www.w3.org/2000/svg" class={iconClass} fill="currentColor" viewBox="0 0 24 24">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z" />
          </svg>
        )}
        {red.nombre === "Instagram" && (
          <svg xmlns="http://www.w3.org/2000/svg" class={iconClass} fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.25 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.25-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45 2.53c.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.28 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z" />
          </svg>
        )}
        {red.nombre === "TikTok" && (
          <svg xmlns="http://www.w3.org/2000/svg" class={iconClass} fill="currentColor" viewBox="0 0 24 24">
            <path d="M16.5 2h-3.2v13.6a2.9 2.9 0 1 1-2.06-2.78v-3.3a6.1 6.1 0 1 0 5.26 6.05V9.03a7.3 7.3 0 0 0 4.3 1.38V7.2a4.15 4.15 0 0 1-4.3-4.16V2Z" />
          </svg>
        )}
      </a>
    ))
  }
</div>
