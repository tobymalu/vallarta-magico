---
import { NAV_LINKS, NAV_LINKS_EN, SITE, whatsappUrl } from "../lib/site";
import SocialLinks from "./SocialLinks.astro";

export interface Props {
  idioma?: "es" | "en";
}

const { idioma = "es" } = Astro.props;
const esEn = idioma === "en";
const links = esEn ? NAV_LINKS_EN : NAV_LINKS;

const anio = new Date().getFullYear();

const t = esEn
  ? {
      tagline: "Tours and excursions in Puerto Vallarta and Banderas Bay: Marietas Islands, Yelapa, Majahuitas, whale watching and more.",
      explorar: "Explore",
      contacto: "Contact",
      derechos: "All rights reserved.",
      // Las 3 páginas legales todavía solo existen en español (fase 2) —
      // mejor ser honestos con "(ES)" que fingir que ya están traducidas.
      aviso: "Privacy Notice (ES)",
      terminos: "Terms & Conditions (ES)",
      cancelacion: "Cancellation Policy (ES)",
    }
  : {
      tagline: "Tours y excursiones en Puerto Vallarta y Bahía de Banderas: islas Marietas, Yelapa, Majahuitas, avistamiento de ballenas y más.",
      explorar: "Explorar",
      contacto: "Contacto",
      derechos: "Todos los derechos reservados.",
      aviso: "Aviso de privacidad",
      terminos: "Términos y condiciones",
      cancelacion: "Políticas de cancelación",
    };
---

<footer class="bg-primary text-primary-foreground">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="font-serif text-xl">
          Vallarta <span class="text-accent">Mágico</span>
        </p>
        <p class="mt-3 max-w-sm text-sm text-primary-foreground/80">
          {t.tagline}
        </p>

        <div class="mt-5">
          <SocialLinks />
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary-foreground/60">
          {t.explorar}
        </p>
        <ul class="mt-4 space-y-2.5">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-primary-foreground/90 hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary-foreground/60">
          {t.contacto}
        </p>
        <ul class="mt-4 space-y-2.5 text-sm text-primary-foreground/90">
          <li>
            <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
              WhatsApp
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-accent">
              {SITE.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-primary-foreground/15 pt-6 text-xs text-primary-foreground/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {anio} {SITE.nombre}. {t.derechos}</p>
      <div class="flex gap-5">
        <a href="/aviso-de-privacidad" class="hover:text-accent">{t.aviso}</a>
        <a href="/terminos-y-condiciones" class="hover:text-accent">{t.terminos}</a>
        <a href="/politicas-de-cancelacion" class="hover:text-accent">{t.cancelacion}</a>
      </div>
    </div>
  </div>
</footer>
