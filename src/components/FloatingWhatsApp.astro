---
// Botón flotante de WhatsApp — visible en todo el sitio EXCEPTO páginas
// de tour (ahí Layout.astro recibe mostrarWhatsappFlotante={false}: ya
// tienen StickyBookBar en mobile y los CTAs del Hero/PriceTable en
// desktop, así que este botón sería un WhatsApp redundante encima).
import { whatsappUrl } from "../lib/site";

export interface Props {
  idioma?: "es" | "en";
}

const { idioma = "es" } = Astro.props;
const esEn = idioma === "en";
const mensaje = esEn
  ? "Hi! I'd like information about tours in Puerto Vallarta and Banderas Bay."
  : undefined; // undefined = usa SITE.whatsapp.mensajeDefault (ya en español)
---

<a
  id="whatsapp-flotante"
  href={whatsappUrl(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={esEn ? "Book via WhatsApp" : "Reservar por WhatsApp"}
  data-ga-event="click_whatsapp_flotante"
  class="fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 hover:bg-[#20bd5a]"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.14.82.84-3.06-.2-.31a8.2 8.2 0 0 1-1.26-4.35c0-4.53 3.69-8.22 8.24-8.22 2.2 0 4.27.86 5.82 2.42a8.16 8.16 0 0 1 2.41 5.81c0 4.53-3.69 8.21-8.23 8.21Zm4.51-6.15c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.24-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.47-.01a.9.9 0 0 0-.66.31c-.23.25-.87.85-.87 2.08 0 1.22.89 2.4 1.02 2.57.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28Z"
    ></path>
  </svg>
</a>

<script>
  const boton = document.getElementById("whatsapp-flotante");
  const cookieBanner = document.getElementById("cookie-banner");

  // Evita "reflow forzado" (PageSpeed): la versión anterior leía
  // cookieBanner.offsetParent/offsetHeight justo cuando el MutationObserver
  // de abajo detectaba que CookieBanner.astro acababa de ESCRIBIR su
  // atributo "hidden" — ese patrón "escribo al DOM → leo geometría de
  // inmediato" es el "layout thrashing" clásico. Ahora:
  // - La visibilidad se lee de cookieBanner.hidden (propiedad booleana
  //   que refleja el atributo — no es una lectura de layout, a
  //   diferencia de offsetParent).
  // - El alto se cachea vía ResizeObserver, cuyo callback ya corre
  //   después de que el navegador resolvió el layout por su cuenta.
  //   Dentro del callback usamos getBoundingClientRect() (border-box,
  //   incluye padding/borde) en vez de entries[0].contentRect (solo
  //   content-box) — CookieBanner tiene padding+borde, así que
  //   contentRect lo dejaba corto y el botón quedaba encimado con el
  //   banner en vez de justo arriba.
  let cookieHeight = 0;

  function ajustar() {
    if (!boton) return;
    const cookieVisible = !!cookieBanner && !cookieBanner.hidden;
    boton.style.bottom = cookieVisible ? `${cookieHeight + 16}px` : "";
  }

  if (cookieBanner) {
    new ResizeObserver((entries) => {
      cookieHeight = entries[0].target.getBoundingClientRect().height;
      ajustar();
    }).observe(cookieBanner);

    // El banner cambia su atributo "hidden" al aceptar/rechazar (ver
    // CookieBanner.astro) — lo observamos para subir/bajar el botón sin
    // depender de que CookieBanner nos avise directamente.
    new MutationObserver(ajustar).observe(cookieBanner, { attributes: true, attributeFilter: ["hidden"] });
  } else {
    ajustar();
  }
</script>
