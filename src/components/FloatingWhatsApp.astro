---
// Botón flotante de WhatsApp, visible en TODO el sitio (todas las
// páginas, desktop incluido). Antes el único CTA de WhatsApp "siempre a
// la vista" era el Header (desktop) y StickyBookBar (solo mobile, solo
// páginas de tour) — el resto del sitio (Home, Guía, Nosotros...) no
// tenía un CTA de WhatsApp persistente.
//
// En páginas de tour, en mobile, StickyBookBar ya cumple este rol (barra
// completa con precio + CTA) — mostrar también este botón ahí sería un
// WhatsApp duplicado pisándose visualmente con esa barra. Por eso el
// script se oculta a sí mismo cuando detecta un StickyBookBar visible, y
// se corre hacia arriba cuando el banner de cookies está visible (mismo
// criterio de coordinación que ya usa CookieBanner con StickyBookBar).
import { whatsappUrl } from "../lib/site";
---

<a
  id="whatsapp-flotante"
  href={whatsappUrl()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Reservar por WhatsApp"
  data-ga-event="click_whatsapp_flotante"
  class="fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 hover:bg-[#20bd5a]"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.14.82.84-3.06-.2-.31a8.2 8.2 0 0 1-1.26-4.35c0-4.53 3.69-8.22 8.24-8.22 2.2 0 4.27.86 5.82 2.42a8.16 8.16 0 0 1 2.41 5.81c0 4.53-3.69 8.21-8.23 8.21Zm4.51-6.15c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.24-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.47-.01a.9.9 0 0 0-.66.31c-.23.25-.87.85-.87 2.08 0 1.22.89 2.4 1.02 2.57.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28Z"
    ></path>
  </svg>
</a>

<script>
  const boton = document.getElementById("whatsapp-flotante");
  const stickyBookBar = document.getElementById("sticky-book-bar");
  const cookieBanner = document.getElementById("cookie-banner");

  function ajustar() {
    if (!boton) return;

    const stickyVisible = !!stickyBookBar && stickyBookBar.offsetParent !== null;
    if (stickyVisible) {
      boton.style.display = "none";
      return;
    }
    boton.style.display = "flex";

    const cookieVisible = !!cookieBanner && cookieBanner.offsetParent !== null;
    boton.style.bottom = cookieVisible ? `${cookieBanner.offsetHeight + 16}px` : "";
  }

  ajustar();
  window.addEventListener("resize", ajustar);

  // El banner de cookies se oculta con el atributo "hidden" al aceptar/
  // rechazar (ver CookieBanner.astro) — observamos ese cambio para volver
  // a bajar el botón sin depender de que CookieBanner nos avise.
  if (cookieBanner) {
    new MutationObserver(ajustar).observe(cookieBanner, { attributes: true, attributeFilter: ["hidden"] });
  }
</script>
