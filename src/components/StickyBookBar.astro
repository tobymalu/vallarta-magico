---
export interface Props {
  precioLabel: string; // ej. "Desde $700 MXN"
  ctaHref: string;
  ctaLabel: string;
}

const { precioLabel, ctaHref, ctaLabel } = Astro.props;
---

<div
  id="sticky-book-bar"
  class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-4 border-t border-foreground/10 bg-white/95 px-5 py-3 backdrop-blur lg:hidden"
>
  <span class="font-serif text-lg text-primary">{precioLabel}</span>
  <a
    href={ctaHref}
    target="_blank"
    rel="noopener noreferrer"
    data-ga-event="click_reservar_sticky"
    class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-foreground"
  >
    {ctaLabel}
  </a>
</div>
