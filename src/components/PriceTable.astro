---
export interface Props {
  precios: {
    etiqueta: string;
    precio: number;
    precio_regular?: number;
    moneda: "MXN" | "USD";
    nota?: string;
    tipo: "estandar" | "addon";
  }[];
  notaPrecio?: string;
  // Amenidades/diferenciadores del tour (ej. "🔬 Bióloga a bordo"),
  // renderizados justo debajo de las tarjetas de precio para anclar el
  // valor antes de que el usuario siga haciendo scroll.
  highlights?: string[];
  ctaHref: string;
  ctaLabel: string;
  // Enlace a /politicas-de-cancelacion — mismo criterio que en TourHero.
  garantiaHref?: string;
  idioma?: "es" | "en";
}

const { precios, notaPrecio, highlights = [], ctaHref, ctaLabel, garantiaHref, idioma = "es" } = Astro.props;
const esEn = idioma === "en";
const locale = esEn ? "en-US" : "es-MX";

const t = esEn
  ? {
      titulo: "Prices",
      subtitulo: "No surprises: this is exactly what you pay.",
      paseAlternativo: "Alternate pass",
      promo: "🔥 Promo -",
      garantiaPrefix: "✅ Risk-free booking: ",
      garantiaLink: "free cancellation up to 24 hours before",
    }
  : {
      titulo: "Precios",
      subtitulo: "Sin sorpresas: esto es exactamente lo que pagas.",
      paseAlternativo: "Pase alternativo",
      promo: "🔥 Promo -",
      garantiaPrefix: "✅ Reserva sin riesgo: ",
      garantiaLink: "cancelación gratuita hasta 24 horas antes",
    };
---

<section class="px-6 py-14" id="precios">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-serif text-3xl text-foreground">{t.titulo}</h2>
    <p class="mt-2 text-sm text-muted">{t.subtitulo}</p>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        precios.map((nivel) => (
          <div
            class={
              nivel.tipo === "addon"
                ? "rounded-2xl border-2 border-dashed border-accent/50 bg-accent/5 p-6"
                : "rounded-2xl border border-foreground/10 bg-white p-6"
            }
          >
            {nivel.tipo === "addon" && (
              <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-accent">
                {t.paseAlternativo}
              </p>
            )}
            {nivel.precio_regular && (
              <p class="mb-1 inline-block rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-accent-foreground">
                {t.promo}{Math.round((1 - nivel.precio / nivel.precio_regular) * 100)}%
              </p>
            )}
            <p class="text-sm font-semibold uppercase tracking-wide text-muted">
              {nivel.etiqueta}
            </p>
            {nivel.precio_regular && (
              <p class="mt-2 text-sm text-muted line-through">
                ${nivel.precio_regular.toLocaleString(locale)} {nivel.moneda}
              </p>
            )}
            <p class={`font-serif text-3xl text-primary ${nivel.precio_regular ? "" : "mt-2"}`}>
              ${nivel.precio.toLocaleString(locale)}
              <span class="text-base font-sans text-muted"> {nivel.moneda}</span>
            </p>
            {nivel.nota && <p class="mt-2 text-xs text-muted">{nivel.nota}</p>}
          </div>
        ))
      }
    </div>

    {
      highlights.length > 0 && (
        <ul class="mx-auto mt-6 flex max-w-xl flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-medium text-foreground">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      notaPrecio && (
        <p class="mx-auto mt-6 max-w-xl rounded-xl bg-accent/10 px-4 py-3 text-sm text-foreground">
          {notaPrecio}
        </p>
      )
    }

    <a
      href={ctaHref}
      target="_blank"
      rel="noopener noreferrer"
      data-ga-event="click_reservar"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground transition hover:bg-primary/90"
    >
      {ctaLabel}
    </a>

    {
      garantiaHref && (
        <p class="mt-4 text-sm text-muted">
          {t.garantiaPrefix}
          <a href={garantiaHref} class="underline underline-offset-2 hover:text-accent">
            {t.garantiaLink}
          </a>
        </p>
      )
    }
  </div>
</section>
