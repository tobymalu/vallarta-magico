---
// Carrusel de fotos horizontal, reutilizable (tours, y a futuro guía u
// otras colecciones que tengan "galeria"). Sin librerías: scroll nativo
// con snap (funciona con swipe en móvil sin JS) + botones prev/next para
// desktop, mismo patrón de script vanilla que ya usa Header.astro.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  fotos: { imagen: ImageMetadata; alt: string }[];
  titulo?: string;
}

const { fotos, titulo = "Galería" } = Astro.props;
---

{
  fotos.length > 0 && (
    <section class="px-6 py-14" data-gallery>
      <div class="mx-auto max-w-6xl">
        <div class="flex items-center justify-between">
          <h2 class="font-serif text-2xl text-foreground">{titulo}</h2>
          <div class="hidden gap-2 sm:flex">
            <button
              type="button"
              data-gallery-prev
              aria-label="Foto anterior"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-foreground/15 text-foreground transition hover:bg-foreground/5"
            >
              ‹
            </button>
            <button
              type="button"
              data-gallery-next
              aria-label="Foto siguiente"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-foreground/15 text-foreground transition hover:bg-foreground/5"
            >
              ›
            </button>
          </div>
        </div>

        <div
          data-gallery-track
          class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2
            [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {fotos.map((foto) => (
            <div class="aspect-4/3 w-72 shrink-0 snap-start overflow-hidden rounded-2xl sm:w-96">
              <Image src={foto.imagen} alt={foto.alt} width={480} height={360} class="h-full w-full object-cover" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    if (!track) return;

    const desplazar = (direccion: 1 | -1) => {
      track.scrollBy({ left: direccion * track.clientWidth * 0.9, behavior: "smooth" });
    };

    gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => desplazar(-1));
    gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => desplazar(1));
  });
</script>
